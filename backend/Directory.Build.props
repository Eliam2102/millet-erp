<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Company>Tiglass / Millet</Company>
    <Product>Millet ERP</Product>
    <!--
      Reglas de performance/estilo del analyzer suprimidas globalmente.
      Convención común en proyectos .NET; el costo de cumplirlas no paga
      sus beneficios fuera de hot-paths.

      CA1848 (LoggerMessage source-gen): añade mucho boilerplate; raramente
      paga su costo fuera de hot-paths.
      CA1873 (Avoid expensive logger argument evaluation): misma familia
      que CA1848 — flaggearía cualquier `_logger.LogX(..., expr)` donde
      `expr` no sea una constante. Mismo trade-off: el boilerplate de
      LoggerMessage.Define no paga.
      CA1305 (IFormatProvider): rule de cultura que dispara en libraries
      como Serilog Console sink que no acepta IFormatProvider directo.
    -->
    <NoWarn>$(NoWarn);CA1848;CA1873;CA1305</NoWarn>
  </PropertyGroup>

  <!--
    Suprime CA1707 (underscores en identificadores) solo en proyectos de
    test. La convención de naming Should_X_When_Y de ADR-0016 requiere
    underscores; CA1707 sigue activa para código de producción.
  -->
  <PropertyGroup Condition="$(MSBuildProjectName.Contains('Tests'))">
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <!-- Analyzers aplicados a todos los proyectos -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
  </ItemGroup>

</Project>
