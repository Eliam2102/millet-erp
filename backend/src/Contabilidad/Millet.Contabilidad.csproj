<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Millet.Contabilidad</RootNamespace>
    <AssemblyName>Millet.Contabilidad</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharedKernel\Millet.SharedKernel.csproj" />
    <!-- Catalogos: EstatusCatalogo (Activo/Inactivo), reuso del catálogo común. -->
    <ProjectReference Include="..\Catalogos\Millet.Catalogos.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="MediatR" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Millet.Contabilidad.UnitTests" />
    <InternalsVisibleTo Include="Millet.Contabilidad.IntegrationTests" />
    <InternalsVisibleTo Include="Millet.Api.IntegrationTests" />
  </ItemGroup>

</Project>
