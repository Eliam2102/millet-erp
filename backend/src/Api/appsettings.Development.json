{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    }
  },
  "Auth": {
    "Mode": "FakeForLocalDev",
    "Jwt": {
      // Dev local: clave conocida y pública por diseño. NO se usa fuera de
      // Development (AuthModeValidator + #if DEBUG en /api/dev/fake-login
      // garantizan que este modo no llega a QA/Prod). En QA/Prod la
      // SigningKey viene de Key Vault. Mínimo 32 bytes para HMAC SHA-256.
      "SigningKey": "dev-only-local-signing-key-NOT-FOR-PROD-32-bytes-mininum-required-for-hmac-sha256"
    },
    "EntraId": {
      "TenantId": "15035a4e-1273-4e15-9859-68fb3fc7b033",
      "ClientId": "5be93b1d-a0b7-447e-aa87-13e70deabd5d",
      "Audience": "api://5be93b1d-a0b7-447e-aa87-13e70deabd5d"
    },
    // Bootstrap del SuperAdmin para dev local: usa el oid sintético del
    // seed user 'dev-superadmin' de ADR-0015. La empresa inicial es fake
    // (RFC genérico SAT, razón social configurable). En el primer arranque
    // crea todo end-to-end y permite usar /api/dev/fake-login con este oid
    // y obtener un JWT con permisos completos en la empresa inicial.
    "InitialAdminEntraOid": "dev-superadmin",
    "Bootstrap": {
      "EmpresaInicial": {
        "Rfc": "MID010101AAA",
        "RazonSocial": "Millet ERP - Empresa Inicial Dev",
        "RegimenFiscal": "601",
        "NombreComercial": "Millet Dev"
      }
    },
    // PR A — Service principal del Glass Agent dev. AppId y ObjectId son
    // info PÚBLICA de Entra ID (no secrets); el client_secret correspondiente
    // vive en KV como `glass-agent-spn-client-secret`. JSON string serializado
    // (escape de comillas con \") para alinear con el shape de QA/Prod
    // (un solo string que viene de KV). En dev permite recargar SPs sin
    // tocar Bicep ni KV — solo editar este archivo y reiniciar.
    "ServicePrincipalsJson": "[{\"Name\":\"Glass Agent - Development\",\"AppId\":\"990f1714-c0df-4dd8-aef8-429bc50b2f90\",\"ObjectId\":\"855bf829-4004-49eb-b617-1e73dd85f61c\",\"EmpresaRfc\":\"MID010101AAA\",\"Permisos\":[\"integraciones.aw.cotizaciones.crear\",\"integraciones.aw.cotizaciones.consultar\"],\"Notes\":\"SPN dev creado 2026-05-15 via az ad app create. Client secret en KV kv-millet-dev-mxc-01.\"},{\"Name\":\"Reabastecimiento Automatico\",\"AppId\":\"a0000000-0000-4000-8000-0000000000a1\",\"ObjectId\":\"b0000000-0000-4000-8000-0000000000b1\",\"EmpresaRfc\":\"MID010101AAA\",\"Permisos\":[\"compras.requisiciones.crear\",\"compras.requisiciones.seleccionar-requisitante\"],\"Notes\":\"SP interno del motor de reorden (ADR-0047 PR5). AppId/ObjectId sinteticos: no autentica por Entra; solo provee un UsuarioServicio como creador/requisitante de las RQ automaticas.\"}]"
  },
  // Directorio Entra simulado (plan 15, F2). Dominios provisionales hasta
  // que TI confirme los reales. CuentasExistentes = personas que "ya tienen
  // cuenta Microsoft" en el simulador; su OID se deriva del correo.
  "Entra": {
    "Provision": { "Disabled": false },
    "DominiosPermitidos": [ "millet.mx", "millet.com.mx" ],
    "UrlInicioSesion": "http://localhost:5173",
    "Simulacion": {
      "CorreoSandbox": { "Host": "127.0.0.1", "Puerto": 1025 },
      "CuentasExistentes": [
        { "Correo": "ana.lopez@millet.mx", "Nombre": "Ana López" },
        { "Correo": "carlos.ruiz@millet.mx", "Nombre": "Carlos Ruiz" },
        { "Correo": "baja.ejemplo@millet.mx", "Nombre": "Cuenta Deshabilitada", "Habilitada": false }
      ]
    }
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=millet_dev;Username=pgadmin;Password=pgadmin;Include Error Detail=true",
    // PR C — A+W SQL Server reader. Vacío en dev local: el adapter
    // tira AwReaderException IsTransient=true en cada poll, el worker
    // incrementa _consecutiveFailures y la métrica
    // aw.hybrid_connection.healthy=0. Cuando el dev tenga un SQL local
    // (o el HC esté establecido), setear con un connection string real.
    "AwSqlServer": ""
  },
  // PR C — drop service local para dev (sin Hybrid Connection). El
  // adapter HTTP postea acá; si el drop service no está corriendo el
  // worker reporta drop_failed con kind=network (transient).
  "IntegracionesAw": {
    "DropServiceBaseAddress": "http://localhost:5000",
    "DropServiceApiKey": "",
    // Sucursales para dev local — mismo catálogo que prod por ahora. El
    // validador del command rechaza valores fuera de keys con
    // AW_SUCURSAL_INVALIDA. Si necesitas probar con sucursal extra solo
    // en local, agregar key aquí (overlay del appsettings.json base).
    "Sucursales": {
      "CIR": "CIRCUITO",
      "CHI": "CHICHI SUAREZ",
      "CAN": "CANCUN",
      "CON": "CONKAL"
    }
  },
  // CORS para dev local: el frontend Vite arranca en :5173 por default.
  // Si cambias el puerto, agregar el nuevo origin aquí.
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  // Stubs cross-module (F3-PR2). Activos en dev local porque los
  // adapters reales de Almacén / OC no existen todavía. PLATFORM-TODO
  // (<StubsTeardown>): cuando esos submódulos existan, quitar este
  // bloque y borrar los stubs.
  //
  // Stubs.Stock.DefaultRatio=0.0: el stub responde "almacén vacío" por
  // default, de modo que al autorizar una RQ la diferencia completa cae
  // a OC. Sin este override el código default es 1.0 (todo cubierto por
  // almacén → nunca se genera OC), que es lo que necesita la suite de
  // tests pero no el dev local. Los tests overridean esto vía env var
  // en TestAssemblyInit / StubsWebApplicationFactory.
  "Compras": {
    "UseStubs": true,
    "Stubs": {
      "Stock": {
        "DefaultRatio": 0.0
      }
    }
  },
  "Compartido": {
    "Outbox": {
      "Disabled": true
    }
  }
}
