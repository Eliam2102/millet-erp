{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "Auth": {
    "Mode": "EntraId",
    "Jwt": {
      "Issuer": "millet-erp-api",
      "Audience": "millet-erp-api",
      "AccessTokenLifetimeMinutes": 60
      // SigningKey NO se commitea — viene de Key Vault en QA/Prod.
      // En dev local viene de appsettings.Development.json (público por diseño).
    },
    "EntraId": {
      // TenantId, ClientId, Audience vienen de KV en QA/Prod.
      // Solo se usan cuando Auth:Mode = EntraId.
      "TenantId": "",
      "ClientId": "",
      "Audience": ""
    },
    // Bootstrap del primer SuperAdmin (ADR-0007). InitialAdminEntraOid
    // viene de KV en QA/Prod (Key Vault secret name: 'auth-initial-admin-oid'
    // por convención). Si vacío, el bootstrap se omite. La sub-sección
    // Bootstrap.EmpresaInicial es opcional: si presente, también crea la
    // empresa y asigna el SuperAdmin a ella.
    "InitialAdminEntraOid": "",
    "Bootstrap": {
      "EmpresaInicial": {
        "Rfc": "",
        "RazonSocial": "",
        "RegimenFiscal": "601",
        "NombreComercial": ""
      }
    },
    // PR A — Service principals M2M. El valor real es un STRING con JSON
    // serializado de un array de SPs (ver appsettings.Development.json
    // para shape). En QA/Prod este valor lo provee Bicep vía KV ref:
    //   Auth__ServicePrincipalsJson →
    //   @Microsoft.KeyVault(VaultName=...;SecretName=auth-service-principals-json)
    // El string-en-string es deliberado: alinea dev y prod a un único
    // path de parsing (D-QA-PROD-CONFIG del prompt PR A) y evita los
    // app settings indexados (Auth__ServicePrincipals__0__Name, …) que
    // son propensos a errores tipográficos. Trade-off: peor DX al editar
    // a mano en dev; aceptable con ≤2 SPs en fase 1.
    "ServicePrincipalsJson": ""
  },
  // CORS — orígenes permitidos para el frontend SPA. En dev local viene de
  // appsettings.Development.json. En QA/Prod los inyecta Bicep como app
  // settings (Cors__AllowedOrigins__0 con el hostname del SWA, Cors__...__1
  // con cualquier custom domain). Vacío en este archivo = sin CORS por
  // default; el binding produce array vacío y AddCors permite nada.
  "Cors": {
    "AllowedOrigins": []
  },
  // ASP.NET DataProtection — ADR-0037. Cifra credenciales operativas
  // admin-configurables (ApiKey FiscalAPI hoy; futuros módulos pueden
  // reusar el mismo wiring con sus propios SecretCipher / purpose).
  // Si ambos valores están vacíos, DataProtection cae a filesystem en
  // %LOCALAPPDATA%\ASP.NET\DataProtection-Keys (dev local sin Azure).
  // En QA/Prod Bicep los inyecta como app settings:
  //   DataProtection__BlobConnString → KV ref "storage-connection-string"
  //   DataProtection__KeyIdentifier  → URI versionado de la key en KV
  // La Managed Identity del App Service requiere "Key Vault Crypto User"
  // sobre la key y "Storage Blob Data Contributor" sobre el container
  // dataprotection-keys.
  "DataProtection": {
    "BlobConnString": "",
    "KeyIdentifier": ""
  },
  // PR B refactor — OutboxPublisherOptions keyed por nombre del DbContext.
  // Cada módulo declara su sección con su TopicName; el worker resuelve
  // las options vía IOptionsMonitor.Get(nameof(TDbContext)) (Opción D
  // del análisis). La connection string a Service Bus la inyecta el
  // App Service como KV ref ServiceBus__ConnectionString (compartida
  // entre módulos — un solo namespace Service Bus por ambiente).
  "Compras": {
    "Outbox": {
      "ServiceBusTopicName": "compras-events"
    }
  },
  "Almacen": {
    "Outbox": {
      "ServiceBusTopicName": "almacen-events"
    }
  },
  "Facturacion": {
    "Outbox": {
      "ServiceBusTopicName": "facturacion-events"
    },
    "Workers": {
      "EnvioCfdiCorreo": {
        "Disabled": false,
        "IntervalSeconds": 60,
        "MaxIntentos": 3,
        "BatchSize": 50
      },
      "// AwSolicitudes": "EmpresaId vacío (Guid.Empty) → el worker no procesa hasta configurar la empresa de la cola A+W. En dev el reader es stub (cola vacía).",
      "AwSolicitudes": {
        "Disabled": false,
        "IntervalSeconds": 120,
        "BatchSize": 50
      },
      "// AwWriteBack": "PR5 (ADR-0048 D3): drena write-backs pendientes de ingesta_control → tabla-puente (uuid+estado al timbrar/cancelar y reintentos). Al llegar a MaxIntentos deja de barrer ese pendiente (visible en write_back_ultimo_error).",
      "AwWriteBack": {
        "Disabled": false,
        "IntervalSeconds": 120,
        "BatchSize": 50,
        "MaxIntentos": 10
      }
    }
  },
  "CuentasPorCobrar": {
    "Outbox": {
      "ServiceBusTopicName": "cuentas-por-cobrar-events"
    },
    "Reportes": {
      // Buckets de antigüedad (días vencidos, límites superiores; el último
      // es abierto). Nacional observado: 0-15/16-30/31-60/61-90/91+.
      "BucketLimites": [15, 30, 60, 90]
    },
    "AplicacionPagos": {
      // Tolerancia no fiscal por moneda del depósito (levantamiento §2.2:
      // <$50 USD — gate fiscal pendiente; MXN provisional).
      "ToleranciaNoFiscal": {
        "USD": 50,
        "MXN": 1000
      }
    },
    "Alertas": {
      "Disabled": false,
      "IntervalHours": 24,
      "SolunionDiasVencido": 90,
      "AutoBloqueoDiasVencido": 90
    }
  },
  "Tesoreria": {
    "Outbox": {
      "ServiceBusTopicName": "tesoreria-events"
    }
  },
  "CuentasPorPagar": {
    "Outbox": {
      "ServiceBusTopicName": "cuentas-por-pagar-events"
    },
    "Cfdi": {
      "BlobStorage": {
        "RootPath": "./blob-cxp"
      }
    },
    "Workers": {
      "Disabled": false,
      "MailboxIntervalSeconds": 300,
      "// RfcsReceptores": "Usado por CfdiMailboxIngestionWorker para asignar el CFDI recibido a la EmpresaId correcta. Vacío en dev. Migra a integraciones_fiscal.rfcs_receptores cuando el mailbox se promueva a Integraciones.Mailbox.",
      "RfcsReceptores": {},
      "RevisionSla": {
        "Disabled": false,
        "IntervalSeconds": 86400
      },
      "NotaCreditoEnEspera": {
        "Disabled": false,
        "IntervalSeconds": 86400,
        "AlertaDespuesDeDias": 30
      }
    },
    "Mailbox": {
      "TenantId": "",
      "ClientId": "",
      "ClientSecret": "",
      "MailboxUpn": "",
      "InboxFolderName": "Inbox",
      "ProcessedFolderName": "Processed",
      "FailedFolderName": "Failed",
      "MaxMensajesPorTick": 25,
      "TimeoutSecondsGraph": 30
    }
  },
  "IntegracionesFiscal": {
    "// Workers": "Submitter+Poller del flujo asíncrono nuevo. Disabled=true en dev hasta validar con FIEL real en QA. Para activar producción: setear Disabled=false en ambos via app settings de Bicep.",
    "Workers": {
      "Submitter": {
        "Disabled": true,
        "TickIntervalSeconds": 3600,
        "BackfillDays": 7,
        "MaxDaysPerRequest": 1
      },
      "Poller": {
        "Disabled": true,
        "TickIntervalSeconds": 900,
        "BatchSize": 50,
        "CosechaChunkSize": 200,
        "MaxBackoffMinutes": 360
      }
    },
    "// SDK wrapper": "TenantKey lo inyecta Bicep como KV ref en QA/Prod (Sdk__TenantKey → secret 'fiscalapi-tenant-key'). Disabled=true en dev local hasta que el owner configure credenciales.",
    "Sdk": {
      "TenantKey": "",
      "BaseUrl": "https://live.fiscalapi.com",
      "ApiVersion": "v4",
      "TimeZone": "America/Mexico_City",
      "Disabled": true
    }
  },
  "IntegracionesAw": {
    "Outbox": {
      "ServiceBusTopicName": "integraciones-aw-events"
    },
    "DropMaxAttempts": 5,
    "DropServiceBaseAddress": "http://SER-DATA:5000",
    "DropServiceApiKey": "",
    "DropTimeoutSeconds": 180,
    "DropMaxConcurrentMessages": 1,
    "SqlQueryTimeoutSeconds": 5,
    "SqlConnectTimeoutSeconds": 15,
    "Sucursales": {
      "CIR": "CIRCUITO",
      "CHI": "CHICHI SUAREZ",
      "CAN": "CANCUN",
      "CON": "CONKAL"
    },
    "AgentWebhook": {
      "Url": "",
      "Secret": "",
      "TimeoutSeconds": 5
    },
    // Flujo 2 (ADR-0048): ingesta de pedidos en firme → Facturación. Sucursal
    // y canal de venta se resuelven por catálogo (clave_aw de
    // compartido.sucursales y compartido.canales_venta, editables en el
    // admin — FAC-ING-PR2); la clase la traduce la vista a nombre de enum
    // del ERP (doc 04 §4). MapeoComportamiento es SOLO override operativo
    // (llaves sin espacios); vacío = parse directo del valor de la vista.
    "Pedidos": {
      "// NudgeApiKey": "PR7: API key del endpoint /integraciones/aw/pedidos/nudge (header X-Millet-Nudge-Key, la manda MilletAwPedidoNotify.exe tras el INSERT de la customización). Vacía = endpoint apagado (404). Se setea por app settings/KV, jamás aquí.",
      "NudgeApiKey": "",
      "SqlQueryTimeoutSeconds": 5,
      "SqlConnectTimeoutSeconds": 15,
      "MapeoComportamiento": {},
      "MapeoUnidadSat": {
        "M2": "MTK",
        "PZA": "H87",
        "KG": "KGM"
      }
    }
  },
  "ConnectionStrings": {
    "AwSqlServer": "",
    // Flujo 2 (ADR-0048): BD MILLET_INTEGRACION(_DEV) on-prem. KV:
    // aw-integracion-connection-string. VACÍA = quedan los stubs de F3
    // (tercer candado de ambientes — ver Program.cs).
    "AwIntegracionDb": ""
  },
  // Migración one-shot de históricas (ADR-0043 PR #4). Dormida por default.
  // Runbook en Azure: Enabled=true + DryRun=true (reporta) → revisar log →
  // DryRun=false (aplica) → Enabled=false de nuevo tras aplicar.
  "Migraciones": {
    "EntregaHistorica": {
      "Enabled": false,
      "DryRun": true
    }
  },
  "AllowedHosts": "*"
}
