<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      F8-PR3: XML doc comments incluidos en compilación para que
      Microsoft.AspNetCore.OpenApi los exponga como descripciones de
      endpoints / parámetros / respuestas en /openapi/v1.json.
      Suprimimos CS1591 (missing XML on public member) — solo exigimos
      doc en endpoints + DTOs públicos del Api project.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharedKernel\Millet.SharedKernel.csproj" />
    <ProjectReference Include="..\Administracion\Millet.Administracion.csproj" />
    <ProjectReference Include="..\Catalogos\Millet.Catalogos.csproj" />
    <ProjectReference Include="..\DatosMaestros\Millet.DatosMaestros.csproj" />
    <ProjectReference Include="..\Almacen\Millet.Almacen.csproj" />
    <ProjectReference Include="..\CentrosCosto\Millet.CentrosCosto.csproj" />
    <ProjectReference Include="..\Compartido\Millet.Compartido.csproj" />
    <ProjectReference Include="..\Identidad\Millet.Identidad.csproj" />
    <ProjectReference Include="..\Compras\Millet.Compras.csproj" />
    <ProjectReference Include="..\CuentasPorCobrar\Millet.CuentasPorCobrar.csproj" />
    <ProjectReference Include="..\CuentasPorPagar\Millet.CuentasPorPagar.csproj" />
    <ProjectReference Include="..\Facturacion\Millet.Facturacion.csproj" />
    <ProjectReference Include="..\Tesoreria\Millet.Tesoreria.csproj" />
    <ProjectReference Include="..\Integraciones.Aw\Millet.Integraciones.Aw.csproj" />
    <ProjectReference Include="..\Integraciones.Fiscal\Millet.Integraciones.Fiscal.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Graph" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Enrichers.Environment" />
    <PackageReference Include="Serilog.Enrichers.Process" />
    <PackageReference Include="Serilog.Enrichers.Thread" />
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" />
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" />
    <PackageReference Include="MediatR" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Mapster" />
    <PackageReference Include="Mapster.DependencyInjection" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Microsoft.Azure.SignalR" />
    <!--
      DataProtection providers (ADR-0037). En dev local sin
      DataProtection:KeyIdentifier configurado, DataProtection cae a
      filesystem y estos paquetes quedan inertes — no requieren stub.
    -->
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Keys" />
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Blobs" />
    <PackageReference Include="Azure.Identity" />
  </ItemGroup>

</Project>
