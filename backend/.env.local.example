# Plantilla para la terminal que ejecuta la API. .NET no lee este archivo
# automáticamente: copia a backend/.env.local (ignorado por Git), completa los
# valores y cárgalo en la misma terminal antes de iniciar dotnet watch.
# Usa comillas simples en la conexión si contiene espacios o punto y coma.
Auth__Mode=EntraId
Auth__EntraId__TenantId=
Auth__EntraId__ClientId=
Auth__EntraId__Audience=
Auth__InitialAdminEntraOid=
ConnectionStrings__Postgres=

# Opcional: sólo para notificaciones vía Microsoft Graph; no hace falta
# para iniciar sesión en el ERP.
# Auth__EntraId__SenderEmail=
# Auth__EntraId__ClientSecret=
