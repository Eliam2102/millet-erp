# Copiar a frontend/.env.development.local (ignorado por Git) y completar.
# Vite carga este archivo al ejecutar npm run dev y prioriza sus valores
# sobre los de .env.development. Reinicia Vite después de modificarlo.
# Las variables VITE_ quedan visibles en el navegador: nunca pongas secretos.
VITE_AUTH_MODE=EntraId
VITE_API_BASE_URL=http://localhost:5000
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_CLIENT_ID=
VITE_API_AUDIENCE=

# VITE_ENTRA_DOMAIN no se utiliza en el login actual.
# Si la API usa otro puerto, cambia VITE_API_BASE_URL para que coincida.
