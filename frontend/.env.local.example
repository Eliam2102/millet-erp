# Template para overrides locales. Copiar a .env.local (que NO se commitea —
# .env.local y .env.*.local están en .gitignore raíz) y ajustar valores.
# Vite carga .env.local con prioridad sobre .env.development.
#
# Caso 1: apuntar a backend remoto en Azure dev (modo Entra real)
# VITE_API_BASE_URL=https://app-millet-dev-mxc-01.azurewebsites.net
# VITE_AUTH_MODE=EntraId
# VITE_ENTRA_TENANT_ID=<tenant-guid>
# VITE_ENTRA_CLIENT_ID=<spa-app-reg-client-id>
# VITE_API_AUDIENCE=api://<api-app-reg-client-id>/access_as_user

# Caso 2: dev local pero apuntando a un backend en otro puerto
# VITE_API_BASE_URL=http://localhost:5005
