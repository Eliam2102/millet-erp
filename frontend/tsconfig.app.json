{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    /* Path alias para imports tipo "@/lib/utils".
       En TS 5+ los paths se resuelven relativo al tsconfig.json sin baseUrl. */
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"],
  /* Los tests viven al lado del source pero NO entran al build de
     producción: se compilan/ejecutan vía Vitest, que tiene su propio
     pipeline. Excluirlos acá evita que `tsc -b` exija los types de
     vitest/@testing-library/jest-dom para hacer build. */
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/test/**"]
}
