# Defaults de modo production (npm run build). Vite auto-carga este archivo
# cuando NODE_ENV=production. Los valores reales (API URL, tenant, client
# IDs) los inyecta el workflow de deploy (deploy-app-dev.yml) leyéndolos
# de Key Vault. Estos defaults son fallback para builds locales de prueba
# (`npm run build` desde dev sin env vars) — el bundle resultante NO
# funciona, solo sirve para validar que TypeScript compile.

VITE_AUTH_MODE=EntraId
VITE_API_BASE_URL=http://localhost:5000
VITE_ENTRA_TENANT_ID=15035a4e-1273-4e15-9859-68fb3fc7b033
VITE_ENTRA_CLIENT_ID=5be93b1d-a0b7-447e-aa87-13e70deabd5d
VITE_API_AUDIENCE=api://5be93b1d-a0b7-447e-aa87-13e70deabd5d
VITE_ENTRA_DOMAIN=uzieltzaboutlook.onmicrosoft.com