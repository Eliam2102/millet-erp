# Defaults de modo development (npm run dev). Vite auto-carga este archivo
# cuando NODE_ENV=development. Para overrides personales (ej. apuntar a
# backend en Azure dev), copiar .env.local.example a .env.local — ese SÍ
# está gitignored.

VITE_AUTH_MODE=FakeForLocalDev
VITE_API_BASE_URL=http://localhost:5000

# En modo FakeForLocalDev las variables de Entra no se usan, pero Vite las
# requiere declaradas (vite-env.d.ts) para que TypeScript no se queje.
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_CLIENT_ID=
VITE_API_AUDIENCE=
