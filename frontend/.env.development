# Defaults de desarrollo (npm run dev). Cada integrante configura sus IDs de
# Entra en .env.development.local o .env.local, ambos ignorados por Git.
# No publicar identificadores personales ni credenciales en este archivo.

VITE_AUTH_MODE=EntraId
VITE_API_BASE_URL=http://localhost:5000

# Requeridos para iniciar sesión; se completan en el archivo local ignorado.
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_CLIENT_ID=
VITE_API_AUDIENCE=

# Dominios del correo corporativo en el alta de colaborador (separados por
# comas). Deben coincidir con Entra:DominiosPermitidos del API.
VITE_DOMINIOS_CORPORATIVOS=millet.mx,millet.com.mx
