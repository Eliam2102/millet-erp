# Configuración de la demo local. Copia este archivo como `.env.demo.local`
# (ignorado por Git) y llena los valores. NUNCA subas el archivo con valores.
#
# Los valores de Microsoft (Entra) y de FiscalAPI se copian de la computadora
# donde ya funciona la demo, a mano o desde tu gestor de contraseñas.

# --- Base de datos local (Docker) ---
PG_PORT=5432
DEMO_DB=millet_demo

# --- Eventos entre módulos (C1.8) ---
# emulador (por omisión): emulador de Service Bus en Docker (`demo.sh eventos`).
# local: la API entrega los eventos en el mismo proceso, sin emulador.
# DEMO_EVENTOS=local

# --- Inicio de sesión con Microsoft (Entra) · API ---
Auth__Mode=EntraId
Auth__EntraId__TenantId=
Auth__EntraId__ClientId=
Auth__EntraId__Audience=
# Secreto: si prefieres, guárdalo con `dotnet user-secrets` en backend/src/Api en lugar de aquí.
Auth__EntraId__ClientSecret=
Entra__Proveedor=Simulado
# Tu OID de Microsoft: te vuelve super administrador de la empresa de demo al arrancar.
# Se ve en portal.azure.com → Microsoft Entra ID → Usuarios → tu usuario → «Id. de objeto».
Auth__InitialAdminEntraOid=

# --- Tres cuentas operativas de Microsoft, aparte del administrador inicial ---
# Primero inicia sesión con cada cuenta y luego reinicia la API.
# Un solo Rol por cuenta y empresa (ADR-0053); administrador fuera del ensayo.
# Reasignación opt-in: solo Development + DemoSesion habilitado. Volver a false tras configurar.
# Seed__DemoSesion__ReemplazarAsignaciones=true
# A · Comprador (incluye Almacén)
# Seed__DemoSesion__Usuarios__0__Correo=comprador@example.invalid
# Seed__DemoSesion__Usuarios__0__Rol=Compras
# Seed__DemoSesion__Usuarios__0__Sucursales__0=MID
# B · Jefe Compras y CxP
# Seed__DemoSesion__Usuarios__1__Correo=jefe-pagos@example.invalid
# Seed__DemoSesion__Usuarios__1__Rol='Jefe Compras y CxP'
# Seed__DemoSesion__Usuarios__1__Sucursales__0=MID
# C · Dirección y Tesorería
# Seed__DemoSesion__Usuarios__2__Correo=direccion-tesoreria@example.invalid
# Seed__DemoSesion__Usuarios__2__Rol='Dirección y Tesorería'
# Seed__DemoSesion__Usuarios__2__Sucursales__0=MID

# --- Inicio de sesión con Microsoft · pantalla (frontend) ---
VITE_AUTH_MODE=EntraId
VITE_API_BASE_URL=http://localhost:5080
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_DOMAIN=
VITE_API_AUDIENCE=

# --- Timbrado de pruebas (FiscalAPI), opcional ---
IntegracionesFiscal__Sdk__Disabled=
IntegracionesFiscal__Sdk__TenantKey=

# --- A+W de demo y complementos de pago (opcional) ---
# demo.sh ya usa estos valores por omisión; descomenta solo para cambiarlos.
# IntegracionesAw__Clientes__LecturaHabilitada=true
# IntegracionesAw__Clientes__AplicacionHabilitada=true
# IntegracionesAw__Productos__OrigenHabilitado=true
# IntegracionesAw__Clientes__MapeoMoneda__PESOSMX=MXN
# IntegracionesAw__Clientes__MapeoMoneda__USD=USD
# IntegracionesAw__Clientes__MapeoMoneda__Euro=EUR
# Facturacion__ReppAutomatico__SucursalClave=MID
