{
  "$description": "Millet ERP — design tokens. Fuente de verdad: canvas 'Millet ERP — Navegación' (12 pantallas). Todo color, tamaño o radio que use un agente debe salir de aquí.",
  "color": {
    "surface": {
      "page":        { "$value": "#F5F6F8", "$description": "Fondo de la app y de inputs de búsqueda rellenos" },
      "card":        { "$value": "#FFFFFF", "$description": "Tarjetas, tablas, topbar, panel de módulo, diálogos" },
      "subtle":      { "$value": "#FAFBFC", "$description": "Encabezado de tabla, footer de paleta, inputs de filtro" },
      "muted":       { "$value": "#F0F2F6", "$description": "Fondo de íconos en cuadro y tags de módulo" },
      "selected":    { "$value": "#EEF2FC", "$description": "Ítem seleccionado (menú, lista maestra, paleta)" },
      "row-focus":   { "$value": "#F7F9FE", "$description": "Fila de tabla resaltada (la que se abrió)" }
    },
    "text": {
      "primary":     { "$value": "#161B26", "$description": "Texto principal, títulos, valores" },
      "secondary":   { "$value": "#414A5C", "$description": "Texto de celdas secundario, botones ghost, íconos de topbar" },
      "strong-ui":   { "$value": "#2B3243", "$description": "Labels de formulario, ítems de menú, íconos en cuadro" },
      "muted":       { "$value": "#667085", "$description": "Descripciones, meta, fechas relativas, headers de tabla, placeholders" },
      "subtle":      { "$value": "#8A93A5", "$description": "Chevrons, conteos inactivos, íconos ⋯" },
      "on-primary":  { "$value": "#FFFFFF" }
    },
    "border": {
      "default":     { "$value": "#E3E6EC", "$description": "Bordes de tarjetas (como ring 1px), topbar, panel" },
      "divider":     { "$value": "#EEF0F4", "$description": "Separadores internos de una tarjeta (tabs, filtros, encabezados)" },
      "row":         { "$value": "#F0F2F5", "$description": "Línea entre filas de tabla/lista" },
      "control":     { "$value": "#D6DAE2", "$description": "Inputs, selects, botones secundarios, kbd" },
      "dashed":      { "$value": "#C9CED8", "$description": "Chip '+ Filtro' (borde dashed)" },
      "progress-empty": { "$value": "#B5BCC9", "$description": "Punto/paso pendiente" }
    },
    "brand": {
      "primary":       { "$value": "#2748B8", "$description": "Acción primaria, links, tab activa, selección, foco" },
      "primary-hover": { "$value": "#1B3590", "$description": "Hover de primario y texto sobre fondos azules claros" },
      "primary-soft":  { "$value": "#F0F4FD", "$description": "Chip de filtro activo (fondo)" },
      "primary-soft-border": { "$value": "#C8D3F2", "$description": "Chip de filtro activo (borde)" },
      "avatar-bg":     { "$value": "#E8EEFB" },
      "disabled":      { "$value": "#C8D1E8", "$description": "Fondo de botón primario deshabilitado" }
    },
    "rail": {
      "bg":            { "$value": "#131B2C", "$description": "Barra lateral de módulos (oscura)" },
      "item-active-bg":{ "$value": "#26324F" },
      "item-active-fg":{ "$value": "#FFFFFF" },
      "item-fg":       { "$value": "#9AA5BD" },
      "item-disabled-fg": { "$value": "#56617A", "$description": "Módulo sin acceso / fase posterior" }
    },
    "status": {
      "success": { "bg": { "$value": "#E5F4EC" }, "fg": { "$value": "#1E6B45" }, "solid": { "$value": "#1E8E5A" } },
      "warning": { "bg": { "$value": "#FFF4DB" }, "fg": { "$value": "#7A5000" }, "solid": { "$value": "#C98A00" }, "note-bg": { "$value": "#FFF8E8" }, "note-fg": { "$value": "#5C3D00" } },
      "danger":  { "bg": { "$value": "#FDECEC" }, "fg": { "$value": "#A12A2A" }, "solid": { "$value": "#C2362F" }, "ring": { "$value": "#F2B8B8" }, "halo": { "$value": "#FBD5D5" } },
      "info":    { "bg": { "$value": "#EEF2FC" }, "fg": { "$value": "#1B3590" }, "solid": { "$value": "#2748B8" } },
      "neutral": { "bg": { "$value": "#EEF0F4" }, "fg": { "$value": "#414A5C" }, "solid": { "$value": "#414A5C" } },
      "notification-dot": { "$value": "#D6303F" }
    },
    "overlay": {
      "scrim-dialog": { "$value": "rgba(15, 20, 34, 0.42)" },
      "scrim-sheet":  { "$value": "rgba(15, 20, 34, 0.32)" }
    }
  },
  "font": {
    "family": {
      "sans": { "$value": "'IBM Plex Sans', system-ui, sans-serif" },
      "mono": { "$value": "'IBM Plex Mono', ui-monospace, monospace", "$description": "Folios, UUID, RFC, atajos de teclado" }
    },
    "weight": { "regular": { "$value": 400 }, "medium": { "$value": 500 }, "semibold": { "$value": 600 } },
    "size": {
      "2xs":  { "$value": "11px", "$description": "Labels en mayúsculas, rail, tags de módulo, badges de conteo, kbd" },
      "xs":   { "$value": "12px", "$description": "Meta, descripciones, badges de estado, celdas secundarias" },
      "sm":   { "$value": "13px", "$description": "BASE de la app: cuerpo, celdas, botones, inputs" },
      "md":   { "$value": "14px", "$description": "Títulos de sección en detalle; cuerpo en móvil" },
      "lg":   { "$value": "15px", "$description": "Título de tarjeta/panel (h2), nombre de módulo" },
      "xl":   { "$value": "16px", "$description": "Título de diálogo/sheet, input de paleta" },
      "2xl":  { "$value": "18px", "$description": "Números de conteo en listas" },
      "3xl":  { "$value": "22px", "$description": "H1 de pantalla y valor de KPI" },
      "4xl":  { "$value": "24px", "$description": "Saludo de Inicio (único)" }
    }
  },
  "radius": {
    "xs":   { "$value": "4px",  "$description": "kbd" },
    "sm":   { "$value": "6px",  "$description": "Controles de 22–30px, ítems de menú, tags de módulo, botones de fila" },
    "md":   { "$value": "8px",  "$description": "Controles de 32–36px: botones, inputs, search, ítems de paleta" },
    "lg":   { "$value": "10px", "$description": "Tarjetas KPI, tablas, secciones de detalle" },
    "xl":   { "$value": "12px", "$description": "Paneles de Inicio, tarjetas móviles" },
    "2xl":  { "$value": "14px", "$description": "Diálogos (paleta ⌘K)" },
    "pill": { "$value": "999px", "$description": "Badges de estado, contadores, avatar, puntos" }
  },
  "space": {
    "$description": "Base 4px. Valores permitidos para gap/padding.",
    "0.5": { "$value": "2px" }, "1": { "$value": "4px" }, "1.5": { "$value": "6px" }, "2": { "$value": "8px" },
    "2.5": { "$value": "10px" }, "3": { "$value": "12px" }, "3.5": { "$value": "14px" }, "4": { "$value": "16px" },
    "5": { "$value": "20px" }, "6": { "$value": "24px" }, "7": { "$value": "28px" }, "8": { "$value": "32px" }
  },
  "size": {
    "control-xs": { "$value": "22px", "$description": "Badge, tag" },
    "control-sm": { "$value": "28px", "$description": "Botón de fila, paginación, icon-button pequeño" },
    "control-md": { "$value": "30px", "$description": "Filtros y búsqueda dentro de tabla" },
    "control-lg": { "$value": "34px", "$description": "Botones y búsqueda de topbar / header de página" },
    "control-xl": { "$value": "36px", "$description": "Inputs de formulario, botones de sheet" },
    "touch":      { "$value": "44px", "$description": "Mínimo táctil en móvil" },
    "topbar":     { "$value": "56px" },
    "rail":       { "$value": "76px" },
    "rail-item":  { "$value": "64px" },
    "module-panel": { "$value": "240px" },
    "table-header": { "$value": "36px" },
    "table-row":  { "$value": "48px", "$description": "Cómoda (mínimo 44px cuando las filas se estiran). Compacta: 36px" },
    "tabs":       { "$value": "44px" },
    "table-footer": { "$value": "44px" },
    "dialog-width": { "$value": "640px" },
    "sheet-width":  { "$value": "560px" },
    "master-list":  { "$value": "320px" }
  },
  "shadow": {
    "card":        { "$value": "0 0 0 1px #E3E6EC, 0 1px 2px rgba(16,24,40,.04)", "$description": "Tarjetas elevadas (KPI, paneles)" },
    "card-flat":   { "$value": "0 0 0 1px #E3E6EC", "$description": "Tablas, secciones, tarjetas de módulo" },
    "dialog":      { "$value": "0 0 0 1px rgba(16,24,40,.08), 0 24px 48px -12px rgba(16,24,40,.35)" },
    "sheet":       { "$value": "-24px 0 48px -16px rgba(16,24,40,.28)" },
    "tab-active":  { "$value": "inset 0 -2px 0 #2748B8" },
    "list-selected": { "$value": "inset 3px 0 0 #2748B8", "$description": "Solo en la lista maestra del detalle" },
    "dot-halo":    { "$value": "0 0 0 2px #FFFFFF" }
  },
  "icon": {
    "stroke": { "$value": 1.6, "$description": "1.8 en íconos ≤15px; 2 en chevrons de 12px" },
    "size": { "xs": { "$value": "12px" }, "sm": { "$value": "14px" }, "md": { "$value": "16px" }, "lg": { "$value": "18px" }, "xl": { "$value": "20px" } }
  },
  "breakpoint": {
    "mobile": { "$value": "390px" },
    "desktop": { "$value": "1440px", "$description": "Diseño de referencia 1440×900; mínimo soportado 1280" }
  }
}
